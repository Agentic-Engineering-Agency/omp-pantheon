{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Shell(git status:*)",
      "Shell(git log:*)",
      "Shell(bun:*)",
      "Shell(pnpm run *)"
    ],
    "ask": [
      "Shell(git push:*)",
      "Shell(git pull:*)",
      "Read(.env*)"
    ],
    "deny": [
      "Shell(git push --force*)",
      "Shell(git reset --hard*)",
      "Shell(git clean -*)",
      "Read(secrets/**)"
    ],
    "additionalDirectories": []
  }
}
